meta {
  name: GET rabbit(1473) max valid → 200
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/rabbit/1473
  body: none
  auth: inherit
}

headers {
  X-API-Key: aaa
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("max valid input returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("input echoed back", function() {
    expect(res.body.input).to.equal(1473);
  });

  test("result is an integer", function() {
    expect(res.body.result).to.be.a("number");
  });
}
