meta {
  name: GET rabbit(6) → 13
  type: http
  seq: 1
}

get {
  url: http://localhost:8000/rabbit/6
  body: none
  auth: inherit
}

headers {
  X-API-Key: aaa
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("input echoed back", function() {
    expect(res.body.input).to.equal(6);
  });

  test("result is 13", function() {
    expect(res.body.result).to.equal(13);
  });
}
